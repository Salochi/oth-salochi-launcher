<?xml version="1.0" encoding="utf-8"?>
<!--
  The SignPath artifact configuration for the release workflow (paste it into the SignPath project as the
  configuration "initial"). The workflow uploads SalochiLauncher.exe as a GitHub artifact, which arrives as a zip.
  Only an exe whose version resource says "Salochi Launcher", with the version the workflow passes in, gets signed.
  Check it against https://docs.signpath.io/artifact-configuration when setting the project up.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="SalochiLauncher.exe" product-name="Salochi Launcher" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
